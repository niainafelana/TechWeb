{
    "swagger": "2.0",
    "info": {
        "description": "API pour l'application SUN CO.",
        "title": "SUN CO. API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "email": "noums@hacker.com"
        },
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/api/shoes": {
            "get": {
                "description": "Obtenir la liste de toutes les chaussures",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "shoes"
                ],
                "summary": "Récupère toutes les chaussures",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/backend_internal_models.Shoe"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "backend_internal_models.Shoe": {
            "description": "Shoe product information",
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "deleted_at": {
                    "$ref": "#/definitions/gorm.DeletedAt"
                },
                "description": {
                    "description": "Description of the shoe\n@Example: Classic sneaker with air cushioning",
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "images": {
                    "description": "Images associated with the shoe",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/backend_internal_models.ShoeImage"
                    }
                },
                "marque": {
                    "description": "Marque of the shoe\n@Example: Nike",
                    "type": "string"
                },
                "name": {
                    "description": "Name of the shoe model\n@Example: Air Max 90",
                    "type": "string"
                },
                "price": {
                    "description": "Price of the shoe\n@Example: 120.99",
                    "type": "number"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "backend_internal_models.ShoeImage": {
            "description": "Image associated with a shoe product",
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "deleted_at": {
                    "$ref": "#/definitions/gorm.DeletedAt"
                },
                "id": {
                    "type": "integer"
                },
                "shoe_id": {
                    "description": "ID of the associated shoe\n@Example: 1",
                    "type": "integer"
                },
                "updated_at": {
                    "type": "string"
                },
                "url": {
                    "description": "URL of the image\n@Example: https://example.com/shoe.jpg",
                    "type": "string"
                }
            }
        },
        "gorm.DeletedAt": {
            "type": "object",
            "properties": {
                "time": {
                    "type": "string"
                },
                "valid": {
                    "description": "Valid is true if Time is not NULL",
                    "type": "boolean"
                }
            }
        }
    }
}